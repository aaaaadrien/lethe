<?php
// Lethe - application configuration.
declare(strict_types=1);

define('APP_NAME', 'Lethe');

// Public base URL used to build share links.
// Leave empty ('') for automatic detection from $_SERVER (recommended).
// Only hardcode it when auto-detection does not match your environment
// (reverse proxy, different domain, ...). No trailing slash.
define('APP_URL', '');

// Storage paths (protected by .htaccess => not reachable over HTTP)
define('STORAGE_PATH', __DIR__ . '/uploads');
define('TMP_PATH', __DIR__ . '/uploads/tmp');
define('DB_FILE', __DIR__ . '/data/database.sqlite');

// File holding the 256-bit key used to encrypt secret messages.
// Generated automatically on first use (see Lethe\Crypto). Never commit or
// share it: losing it makes unread messages unrecoverable, leaking it allows
// anyone to decrypt them.
define('SECRET_KEY_FILE', __DIR__ . '/data/secret.key');

// Maximum size of a shared file (10 Go).
define('MAX_FILE_SIZE', 10 * 1024 * 1024 * 1024);

// Upload chunk size (1 Mo per AJAX request, keeps requests well under the
// default upload_max_filesize/post_max_size without any php.ini change).
define('CHUNK_SIZE', 1024 * 1024);

// Share link / deposit link lifetime (days).
define('MIN_EXPIRATION_DAYS', 1);
define('MAX_EXPIRATION_DAYS', 30);
define('DEFAULT_EXPIRATION_DAYS', 7);

// Secret messages: allowed lifetimes, default lifetime, max message length.
define('SECRET_EXPIRATION_OPTIONS', [1, 7, 14, 30]);
define('SECRET_DEFAULT_EXPIRATION_DAYS', 7);
define('SECRET_MAX_LENGTH', 5000);

// Session cookie name and lifetime (one year).
define('SESSION_NAME', 'lethe_session');
define('SESSION_LIFETIME', 31536000);

// E-mail configuration.
// 'sendmail' = native PHP mail() (uses the local MTA)
// 'smtp'     = direct SMTP delivery (see SMTP_* below, no external library)
define('MAIL_TRANSPORT', 'smtp');
define('MAIL_FROM_ADDRESS', 'noreply@linuxtricks.fr');
define('MAIL_FROM_NAME', 'Lethe');
// E-mail subject and default body. Leave empty ('') to use the built-in
// templates translated in the sender's language (lang/en.php, lang/fr.php,
// keys "mail.subject" and "mail.body").
define('MAIL_SUBJECT', '');
// Available placeholders: {LINK} {EXPIRATION} {PASSWORD_NOTICE} {SENDER}
define('MAIL_BODY_TEMPLATE', '');

// Deposit notification: subject and body sent to the deposit owner when a
// file is uploaded. Leave empty ('') to use the built-in translated defaults
// (mail.deposit.subject / mail.deposit.body in lang/*.php).
// Available placeholders: {DEPOSIT_LABEL} {UPLOADER_NAME} {DEPOSIT_LINK}
define('MAIL_DEPOSIT_SUBJECT', '');
define('MAIL_DEPOSIT_BODY_TEMPLATE', '');

// Used only when MAIL_TRANSPORT is 'smtp'.
define('SMTP_HOST', 'smtp.linuxtricks.fr');
define('SMTP_PORT', 25);
// 'none' = cleartext (not recommended), 'tls' = STARTTLS (587), 'ssl' = implicit TLS (465)
define('SMTP_ENCRYPTION', 'none');
// Verify the SMTP server certificate. Disable only for troubleshooting
// (self-signed internal cert, ...): otherwise the connection can be intercepted.
define('SMTP_VERIFY_CERT', true);
// Leave empty if the SMTP server does not require authentication.
define('SMTP_USERNAME', '');
define('SMTP_PASSWORD', '');
define('SMTP_TIMEOUT', 15);

// Set OIDC_ENABLED to '1' to enable OIDC login. Leave '0' to disable
// (only username/password login remains).
define('OIDC_ENABLED', '0');

// The Keycloak authorization server URL (base URL of the Keycloak realm).
// Example: 'https://sso.linuxtrickslab.lan/realms/linuxtrickslab'
define('OIDC_AUTH_SERVER', '');

// The Keycloak client ID registered in the realm.
define('OIDC_CLIENT_ID', '');

// The Keycloak client secret (for confidential clients).
define('OIDC_CLIENT_SECRET', '');

// The redirect URI registered in Keycloak. Must match exactly.
// Example: 'https://lethe.linuxtrickslab.lan/index.php?action=oidc_callback'
define('OIDC_REDIRECT_URI', '');

// OIDC scopes to request. 'openid' is always included.
// Add 'profile', 'email', 'offline_access' as needed.
define('OIDC_SCOPES', 'openid profile email');

// JWKS URI for validating JWT signatures (auto-discovered from issuer).
// Leave empty to use the auto-discovered value.
define('OIDC_JWKS_URI', '');

// JWKS cache TTL in seconds (JWKS keys change rarely).
define('OIDC_JWKS_CACHE_TTL', 3600);

// Maximum allowed clock skew in seconds (for token expiry validation).
define('OIDC_CLOCK_SKEW', 30);
